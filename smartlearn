<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>EduNotes — Buy Notes & Past Papers</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
  html { scroll-behavior: smooth; }
  .card-hover { transition: transform .2s, box-shadow .2s; }
  .card-hover:hover { transform: translateY(-4px); box-shadow: 0 12px 24px rgba(0,0,0,.08); }
  .whatsapp-float {
    position: fixed; bottom: 20px; right: 20px; z-index: 50;
    width: 56px; height: 56px; border-radius: 50%;
    background: #25D366; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 12px rgba(0,0,0,.25); transition: transform .2s;
  }
  .whatsapp-float:hover { transform: scale(1.1); }
  .hidden-page { display: none !important; }
  .spinner { border: 3px solid #eee; border-top-color: #16a34a; border-radius: 50%; width: 28px; height: 28px; animation: spin 1s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

<!-- ============ NAVBAR ============ -->
<nav class="bg-white shadow-sm sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="#" onclick="showPage('home')" class="text-xl font-bold text-emerald-700">📚 EduNotes</a>
    <div class="hidden md:flex gap-6 text-sm font-medium">
      <a href="#" onclick="showPage('home')" class="hover:text-emerald-600">Home</a>
      <a href="#" onclick="showPage('notes')" class="hover:text-emerald-600">All Notes</a>
      <a href="#" onclick="showPage('papers')" class="hover:text-emerald-600">Past Papers</a>
      <a href="#" onclick="showPage('contact')" class="hover:text-emerald-600">Contact</a>
      <a href="#" onclick="showPage('admin')" class="text-slate-400 hover:text-slate-600 text-xs">Admin</a>
    </div>
    <button onclick="toggleMobileMenu()" class="md:hidden text-2xl">☰</button>
  </div>
  <div id="mobileMenu" class="hidden md:hidden border-t bg-white">
    <div class="px-4 py-3 flex flex-col gap-3 text-sm">
      <a href="#" onclick="showPage('home');toggleMobileMenu()">Home</a>
      <a href="#" onclick="showPage('notes');toggleMobileMenu()">All Notes</a>
      <a href="#" onclick="showPage('papers');toggleMobileMenu()">Past Papers</a>
      <a href="#" onclick="showPage('contact');toggleMobileMenu()">Contact</a>
      <a href="#" onclick="showPage('admin');toggleMobileMenu()">Admin</a>
    </div>
  </div>
</nav>

<!-- ============ HOME ============ -->
<main id="page-home" class="flex-1">
  <section class="bg-gradient-to-br from-emerald-600 to-teal-700 text-white">
    <div class="max-w-7xl mx-auto px-4 py-16 md:py-24 text-center">
      <h1 class="text-3xl md:text-5xl font-bold mb-4">Access Quality Academic Notes Instantly</h1>
      <p class="text-lg md:text-xl mb-8 text-emerald-50 max-w-2xl mx-auto">
        Buy notes, revision materials, and past papers for just <strong>KSh 100</strong>. Pay via M-Pesa and download instantly.
      </p>
      <div class="max-w-xl mx-auto flex gap-2">
        <input id="homeSearch" type="text" placeholder="Search notes, past papers, course codes..."
          class="flex-1 px-4 py-3 rounded-lg text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-400" />
        <button onclick="searchFromHome()" class="bg-amber-400 hover:bg-amber-500 text-slate-900 font-semibold px-6 py-3 rounded-lg">Search</button>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold mb-6">Browse by Category</h2>
    <div id="homeCategories" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3"></div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold mb-6">Latest Documents</h2>
    <div id="homeDocs" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3"></div>
  </section>
</main>

<!-- ============ NOTES / PAPERS ============ -->
<main id="page-notes" class="hidden-page flex-1 max-w-7xl mx-auto w-full px-4 py-8">
  <h1 class="text-3xl font-bold mb-6" id="notesTitle">All Notes</h1>
  <div class="flex flex-col md:flex-row gap-3 mb-6">
    <input id="searchInput" type="text" placeholder="Search by title or course code..."
      class="flex-1 px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500" />
    <select id="categoryFilter" class="px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500">
      <option value="">All Categories</option>
    </select>
  </div>
  <div id="docsList" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3"></div>
</main>

<!-- ============ DOCUMENT DETAIL ============ -->
<main id="page-document" class="hidden-page flex-1 max-w-3xl mx-auto w-full px-4 py-8">
  <button onclick="history.back()" class="text-emerald-700 text-sm mb-4">← Back</button>
  <div id="docDetail"></div>
</main>

<!-- ============ PAYMENT ============ -->
<main id="page-payment" class="hidden-page flex-1 max-w-lg mx-auto w-full px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">Complete Payment</h1>
  <div id="payDocInfo" class="bg-white p-4 rounded-xl shadow-sm mb-6"></div>
  <form onsubmit="initiatePayment(event)" class="bg-white p-6 rounded-xl shadow-sm space-y-4">
    <div>
      <label class="block text-sm font-medium mb-1">M-Pesa Phone Number</label>
      <input id="payPhone" type="tel" placeholder="07XXXXXXXX" required
        class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500" />
      <p class="text-xs text-slate-500 mt-1">A prompt will appear on your phone. Enter your M-Pesa PIN.</p>
    </div>
    <button id="payBtn" type="submit"
      class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 rounded-lg">
      Pay via M-Pesa
    </button>
  </form>
  <div id="payStatus" class="mt-6 hidden text-center"></div>
</main>

<!-- ============ SUCCESS / FAILED ============ -->
<main id="page-success" class="hidden-page flex-1 max-w-lg mx-auto w-full px-4 py-12 text-center">
  <div class="text-6xl mb-4">✅</div>
  <h1 class="text-2xl font-bold text-emerald-700 mb-2">Payment Successful!</h1>
  <div id="successInfo" class="bg-white p-6 rounded-xl shadow-sm my-6 text-left text-sm space-y-2"></div>
  <a id="downloadBtn" href="#" class="inline-block bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-8 py-3 rounded-lg">
    ⬇ Download Document
  </a>
  <p class="text-xs text-slate-500 mt-3">Link expires in 15 minutes and works once.</p>
</main>

<main id="page-failed" class="hidden-page flex-1 max-w-lg mx-auto w-full px-4 py-12 text-center">
  <div class="text-6xl mb-4">❌</div>
  <h1 class="text-2xl font-bold text-red-600 mb-2">Payment Failed</h1>
  <p id="failReason" class="text-slate-600 mb-6"></p>
  <button onclick="showPage('notes')" class="bg-emerald-600 text-white px-6 py-3 rounded-lg">Try Again</button>
</main>

<!-- ============ CONTACT ============ -->
<main id="page-contact" class="hidden-page flex-1 max-w-2xl mx-auto w-full px-4 py-12">
  <h1 class="text-3xl font-bold mb-6">Contact Us</h1>
  <div class="bg-white p-6 rounded-xl shadow-sm mb-6">
    <p class="mb-4 text-slate-600">Have a question about our notes or need help with a purchase? Reach us on WhatsApp.</p>
    <a href="https://wa.me/254751841512?text=Hello%2C%20I%20visited%20your%20educational%20notes%20website%20and%20I%20would%20like%20to%20make%20an%20enquiry%20about%20your%20notes%20and%20past%20papers."
      target="_blank"
      class="inline-flex items-center gap-2 bg-[#25D366] hover:bg-[#1ebe5b] text-white font-semibold px-6 py-3 rounded-lg">
      💬 Chat on WhatsApp
    </a>
  </div>
  <form onsubmit="sendEnquiry(event)" class="bg-white p-6 rounded-xl shadow-sm space-y-3">
    <h2 class="font-semibold mb-2">Or send a message</h2>
    <input id="enqName" placeholder="Your name" class="w-full px-4 py-2 border rounded-lg" />
    <input id="enqPhone" placeholder="Your phone" class="w-full px-4 py-2 border rounded-lg" />
    <textarea id="enqMsg" placeholder="Your message" required rows="4" class="w-full px-4 py-2 border rounded-lg"></textarea>
    <button class="bg-emerald-600 text-white px-6 py-2 rounded-lg">Send</button>
    <p id="enqStatus" class="text-sm text-emerald-700"></p>
  </form>
</main>

<!-- ============ ADMIN LOGIN ============ -->
<main id="page-admin" class="hidden-page flex-1 max-w-md mx-auto w-full px-4 py-12">
  <h1 class="text-2xl font-bold mb-6">Admin Login</h1>
  <form onsubmit="adminLogin(event)" class="bg-white p-6 rounded-xl shadow-sm space-y-3">
    <input id="adminUser" placeholder="Username" required class="w-full px-4 py-2 border rounded-lg" />
    <input id="adminPass" type="password" placeholder="Password" required class="w-full px-4 py-2 border rounded-lg" />
    <button class="w-full bg-slate-800 text-white py-2 rounded-lg font-semibold">Login</button>
    <p id="loginError" class="text-sm text-red-600"></p>
  </form>
</main>

<!-- ============ ADMIN DASHBOARD ============ -->
<main id="page-adminDash" class="hidden-page flex-1 max-w-7xl mx-auto w-full px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">Admin Dashboard</h1>
    <button onclick="adminLogout()" class="text-sm bg-slate-200 px-4 py-2 rounded-lg">Logout</button>
  </div>

  <div id="statsGrid" class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8"></div>

  <div class="grid lg:grid-cols-2 gap-6">
    <div class="bg-white p-6 rounded-xl shadow-sm">
      <h2 class="font-bold mb-4">Upload New Document</h2>
      <form onsubmit="uploadDoc(event)" class="space-y-3">
        <input id="upTitle" placeholder="Title" required class="w-full px-3 py-2 border rounded-lg" />
        <textarea id="upDesc" placeholder="Description" rows="2" class="w-full px-3 py-2 border rounded-lg"></textarea>
        <select id="upCat" required class="w-full px-3 py-2 border rounded-lg"></select>
        <input id="upPrice" type="number" value="100" min="1" class="w-full px-3 py-2 border rounded-lg" />
        <input id="upFile" type="file" accept=".pdf,.doc,.docx" required class="w-full text-sm" />
        <button class="bg-emerald-600 text-white px-6 py-2 rounded-lg font-semibold">Upload</button>
        <p id="upStatus" class="text-sm"></p>
      </form>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm">
      <h2 class="font-bold mb-4">Recent Transactions</h2>
      <div id="adminTx" class="text-sm space-y-2 max-h-96 overflow-y-auto"></div>
    </div>
  </div>

  <div class="bg-white p-6 rounded-xl shadow-sm mt-6">
    <h2 class="font-bold mb-4">Manage Documents</h2>
    <div id="adminDocs" class="text-sm space-y-2"></div>
  </div>
</main>

