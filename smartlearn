<script>
// ============ STATE ============
let currentDoc = null;
let pollTimer = null;
let currentCheckoutId = null;
let categories = [];

// ============ NAVIGATION ============
function showPage(name) {
  document.querySelectorAll('main[id^="page-"]').forEach(m => m.classList.add('hidden-page'));
  const el = document.getElementById('page-' + name);
  if (el) el.classList.remove('hidden-page');
  window.scrollTo(0, 0);
  if (name === 'notes' || name === 'papers') loadDocuments(name);
  if (name === 'admin') checkAdmin();
  if (name === 'adminDash') loadAdminData();
  if (name === 'home') loadHome();
}

function toggleMobileMenu() {
  document.getElementById('mobileMenu').classList.toggle('hidden');
}

// ============ HOME ============
async function loadHome() {
  const cats = await fetch('/api/categories').then(r => r.json());
  categories = cats;
  const catBox = document.getElementById('homeCategories');
  catBox.innerHTML = cats.map(c => `
    <button onclick="filterCategory('${c.slug}')"
      class="bg-white p-4 rounded-xl shadow-sm hover:shadow-md card-hover text-sm font-medium text-left">
      ${c.name}
    </button>`).join('');

  const docs = await fetch('/api/documents').then(r => r.json());
  document.getElementById('homeDocs').innerHTML = docs.slice(0, 6).map(docCard).join('');
}

function searchFromHome() {
  const q = document.getElementById('homeSearch').value.trim();
  showPage('notes');
  document.getElementById('searchInput').value = q;
  loadDocuments('notes', q);
}

function filterCategory(slug) {
  showPage('notes');
  document.getElementById('categoryFilter').value = slug;
  loadDocuments('notes');
}

// ============ DOCUMENTS LIST ============
async function loadDocuments(page, forcedQuery) {
  document.getElementById('notesTitle').textContent = page === 'papers' ? 'Past Examination Papers' : 'All Notes';
  const filter = document.getElementById('categoryFilter');
  if (!filter.options.length || filter.options.length === 1) {
    filter.innerHTML = '<option value="">All Categories</option>' +
      categories.map(c => `<option value="${c.slug}">${c.name}</option>`).join('');
  }
  if (page === 'papers') filter.value = 'past-examination-papers';

  const q = forcedQuery !== undefined ? forcedQuery : document.getElementById('searchInput').value;
  const cat = filter.value;
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (cat) params.set('category', cat);

  const docs = await fetch('/api/documents?' + params).then(r => r.json());
  document.getElementById('docsList').innerHTML = docs.length
    ? docs.map(docCard).join('')
    : '<p class="col-span-full text-slate-500">No documents found.</p>';
}

function docCard(d) {
  return `
    <div class="bg-white rounded-xl shadow-sm p-5 card-hover flex flex-col">
      <div class="text-xs text-emerald-700 font-semibold mb-2">${d.category || 'General'}</div>
      <h3 class="font-bold text-lg mb-2">${escapeHtml(d.title)}</h3>
      <p class="text-sm text-slate-600 mb-4 flex-1">${escapeHtml((d.description || '').slice(0, 100))}${(d.description||'').length>100?'…':''}</p>
      <div class="flex items-center justify-between">
        <span class="text-xl font-bold text-emerald-700">KSh ${d.price_ksh}</span>
        <button onclick="viewDoc(${d.id})" class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm px-4 py-2 rounded-lg">View</button>
      </div>
    </div>`;
}

// ============ DOCUMENT DETAIL ============
async function viewDoc(id) {
  showPage('document');
  const d = await fetch('/api/documents/' + id).then(r => r.json());
  currentDoc = d;
  document.getElementById('docDetail').innerHTML = `
    <div class="bg-white p-6 rounded-xl shadow-sm">
      <div class="text-sm text-emerald-700 font-semibold mb-2">${d.category || ''}</div>
      <h1 class="text-2xl font-bold mb-3">${escapeHtml(d.title)}</h1>
      <p class="text-slate-600 mb-6">${escapeHtml(d.description || '')}</p>
      <div class="flex items-center justify-between border-t pt-4">
        <div>
          <div class="text-3xl font-bold text-emerald-700">KSh ${d.price_ksh}</div>
          <div class="text-xs text-slate-500">${d.download_count} downloads</div>
        </div>
        <button onclick="goToPayment(${d.id})" class="bg-amber-400 hover:bg-amber-500 text-slate-900 font-bold px-8 py-3 rounded-lg">
          Buy & Download
        </button>
      </div>
    </div>`;
}

// ============ PAYMENT ============
async function goToPayment(id) {
  showPage('payment');
  const d = await fetch('/api/documents/' + id).then(r => r.json());
  currentDoc = d;
  document.getElementById('payDocInfo').innerHTML = `
    <div class="text-sm text-slate-500">You are paying for</div>
    <div class="font-bold text-lg">${escapeHtml(d.title)}</div>
    <div class="text-2xl font-bold text-emerald-700 mt-2">KSh ${d.price_ksh}</div>`;
  document.getElementById('payStatus').classList.add('hidden');
  document.getElementById('payBtn').disabled = false;
  document.getElementById('payBtn').textContent = 'Pay via M-Pesa';
}

async function initiatePayment(e) {
  e.preventDefault();
  const phone = document.getElementById('payPhone').value.trim();
  if (!currentDoc) return;
  const btn = document.getElementById('payBtn');
  btn.disabled = true;
  btn.textContent = 'Sending STK Push...';

  const statusBox = document.getElementById('payStatus');
  statusBox.classList.remove('hidden');
  statusBox.innerHTML = '<div class="spinner mx-auto mb-2"></div><p class="text-slate-600">Check your phone and enter M-Pesa PIN…</p>';

  try {
    const res = await fetch('/api/payment/initiate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ document_id: currentDoc.id, phone })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Failed');

    currentCheckoutId = data.checkout_request_id;
    pollStatus();
  } catch (err) {
    statusBox.innerHTML = `<p class="text-red-600">${escapeHtml(err.message)}</p>`;
    btn.disabled = false;
    btn.textContent = 'Retry';
  }
}

function pollStatus() {
  if (pollTimer) clearInterval(pollTimer);
  let attempts = 0;
  pollTimer = setInterval(async () => {
    attempts++;
    if (attempts > 40) {
      clearInterval(pollTimer);
      showPaymentFailed('Timed out waiting for confirmation.');
      return;
    }
    try {
      const r = await fetch('/api/payment/status/' + currentCheckoutId).then(x => x.json());
      if (r.status === 'success') {
        clearInterval(pollTimer);
        showPaymentSuccess(r);
      } else if (r.status === 'failed') {
        clearInterval(pollTimer);
        showPaymentFailed(r.result_desc || 'Payment was not completed.');
      }
    } catch (e) {}
  }, 3000);
}

async function showPaymentSuccess(tx) {
  showPage('success');
  document.getElementById('successInfo').innerHTML = `
    <div><strong>Status:</strong> <span class="text-emerald-700">Paid</span></div>
    <div><strong>Document:</strong> ${escapeHtml(currentDoc.title)}</div>
    <div><strong>Amount:</strong> KSh ${tx.amount}</div>
    <div><strong>M-Pesa Ref:</strong> ${tx.mpesa_receipt || '—'}</div>
    <div><strong>Date:</strong> ${new Date(tx.completed_at).toLocaleString()}</div>`;
  try {
    const t = await fetch('/api/payment/download-token/' + currentCheckoutId).then(r => r.json());
    document.getElementById('downloadBtn').href = '/download/' + t.token;
  } catch (e) {
    document.getElementById('downloadBtn').textContent = 'Generating link…';
  }
}

function showPaymentFailed(reason) {
  showPage('failed');
  document.getElementById('failReason').textContent = reason;
}

// ============ CONTACT ============
async function sendEnquiry(e) {
  e.preventDefault();
  const body = {
    name: document.getElementById('enqName').value,
    phone: document.getElementById('enqPhone').value,
    message: document.getElementById('enqMsg').value
  };
  await fetch('/api/enquiries', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body)
  });
  document.getElementById('enqStatus').textContent = 'Message sent. We will reply soon.';
  e.target.reset();
}

// ============ ADMIN ============
async function checkAdmin() {
  const r = await fetch('/admin/me').then(x => x.json());
  if (r.isAdmin) { showPage('adminDash'); loadAdminData(); }
}

async function adminLogin(e) {
  e.preventDefault();
  const r = await fetch('/admin/login', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      username: document.getElementById('adminUser').value,
      password: document.getElementById('adminPass').value
    })
  });
  const data = await r.json();
  if (r.ok) { showPage('adminDash'); loadAdminData(); }
  else document.getElementById('loginError').textContent = data.error;
}

async function adminLogout() {
  await fetch('/admin/logout', { method: 'POST' });
  showPage('home');
}

async function loadAdminData() {
  const [stats, tx, docs] = await Promise.all([
    fetch('/admin/stats').then(r => r.json()),
    fetch('/admin/transactions').then(r => r.json()),
    fetch('/api/documents').then(r => r.json())
  ]);

  document.getElementById('statsGrid').innerHTML = `
    ${statCard('Total Revenue', 'KSh ' + stats.revenue)}
    ${statCard('Payments', stats.payments)}
    ${statCard('Documents', stats.documents)}
    ${statCard('Enquiries', stats.enquiries)}`;

  document.getElementById('upCat').innerHTML = categories.map(c =>
    `<option value="${c.id}">${c.name}</option>`).join('');

  document.getElementById('adminTx').innerHTML = tx.length ? tx.map(t => `
    <div class="border-b pb-2">
      <div class="font-medium">${escapeHtml(t.title || '—')}</div>
      <div class="text-xs text-slate-500">${t.phone_number} · KSh ${t.amount} · ${t.status}</div>
    </div>`).join('') : '<p class="text-slate-500">No transactions yet.</p>';

  document.getElementById('adminDocs').innerHTML = docs.length ? docs.map(d => `
    <div class="flex justify-between items-center border-b pb-2">
      <div>
        <div class="font-medium">${escapeHtml(d.title)}</div>
        <div class="text-xs text-slate-500">KSh ${d.price_ksh} · ${d.download_count} downloads</div>
      </div>
      <button onclick="deleteDoc(${d.id})" class="text-red-600 text-sm">Delete</button>
    </div>`).join('') : '<p class="text-slate-500">No documents.</p>';
}

function statCard(label, value) {
  return `<div class="bg-white p-4 rounded-xl shadow-sm">
    <div class="text-xs text-slate-500">${label}</div>
    <div class="text-2xl font-bold text-slate-800">${value}</div>
  </div>`;
}

async function uploadDoc(e) {
  e.preventDefault();
  const fd = new FormData();
  fd.append('title', document.getElementById('upTitle').value);
  fd.append('description', document.getElementById('upDesc').value);
  fd.append('category_id', document.getElementById('upCat').value);
  fd.append('price_ksh', document.getElementById('upPrice').value);
  fd.append('file', document.getElementById('upFile').files[0]);

  const r = await fetch('/admin/documents', { method: 'POST', body: fd });
  const data = await r.json();
  document.getElementById('upStatus').textContent = r.ok ? 'Uploaded!' : ('Error: ' + data.error);
  if (r.ok) { e.target.reset(); loadAdminData(); }
}

async function deleteDoc(id) {
  if (!confirm('Delete this document?')) return;
  await fetch('/admin/documents/' + id, { method: 'DELETE' });
  loadAdminData();
}

// ============ UTIL ============
function escapeHtml(s) {
  return String(s || '').replace(/[&<>"']/g, c =>
    ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
}

// ============ BOOT ============
(async () => {
  await loadHome();
  // Load categories for filter
  categories = await fetch('/api/categories').then(r => r.json());
  document.getElementById('categoryFilter').innerHTML =
    '<option value="">All Categories</option>' +
    categories.map(c => `<option value="${c.slug}">${c.name}</option>`).join('');

  document.getElementById('searchInput').addEventListener('input', debounce(() => loadDocuments('notes'), 300));
  document.getElementById('categoryFilter').addEventListener('change', () => loadDocuments('notes'));
})();

function debounce(fn, ms) {
  let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); };
}
</script>
